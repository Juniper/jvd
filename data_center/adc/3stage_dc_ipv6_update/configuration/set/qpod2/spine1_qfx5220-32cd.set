set protocols bgp graceful-restart dont-help-shared-fate-bfd-down
set protocols bgp multipath
set protocols lldp port-id-subtype interface-name
set protocols lldp port-description-type interface-description
set protocols lldp neighbour-port-info-display port-id
set protocols lldp interface all
set protocols sflow agent-id inet6 fdf6:ed70:1fac:f2d2::1001
set protocols sflow polling-interval 10
set protocols sflow sample-rate ingress 1024
set protocols sflow sample-rate egress 1024
set protocols sflow source-ip inet6 fdf6:ed70:1fac:f2d2::1001
set protocols sflow collector 2001:db8:dc4:10:d8:1:0:2 udp-port 6343
set protocols sflow interfaces et-0/0/0.0
set protocols sflow interfaces et-0/0/3.0
set protocols sflow interfaces et-0/0/4.0
set protocols sflow interfaces et-0/0/7.0
set protocols sflow interfaces et-0/0/8.0
set protocols sflow interfaces et-0/0/9.0
set protocols sflow interfaces et-0/0/10.0
set protocols sflow interfaces et-0/0/11.0
set protocols sflow interfaces et-0/0/12.0
set protocols sflow interfaces et-0/0/13.0
set protocols rstp disable
