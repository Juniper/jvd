set version 25.2R2-S2.2
set groups PROTECT_RE_CONFIGLET interfaces lo0 unit 0 family inet filter input cpp-filter
set groups PROTECT_RE_CONFIGLET interfaces lo0 unit 0 family inet6 filter input cpp-filter-ipv6
set groups PROTECT_RE_CONFIGLET policy-options prefix-list BGP_NEIGHBORS_V4 apply-path "protocols bgp group <*> neighbor <*>"
set groups PROTECT_RE_CONFIGLET policy-options prefix-list BGP_VRF_NEIGHBOURS_V4 apply-path "routing-instances <*> protocols bgp group <*> neighbor <*>"
set groups PROTECT_RE_CONFIGLET policy-options prefix-list REMOTE_MGMT_NETS_V4 10.0.0.0/8
set groups PROTECT_RE_CONFIGLET policy-options prefix-list REMOTE_MGMT_NETS_V4 66.0.0.0/8
set groups PROTECT_RE_CONFIGLET policy-options prefix-list REMOTE_MGMT_NETS_V4 172.0.0.0/8
set groups PROTECT_RE_CONFIGLET policy-options prefix-list REMOTE_MGMT_NETS_V4 192.0.0.0/8
set groups PROTECT_RE_CONFIGLET policy-options prefix-list DNS_SERVERS_V4 apply-path "system name-server <*>"
set groups PROTECT_RE_CONFIGLET policy-options prefix-list NTP_SERVERS_V4 apply-path "system ntp server <*>"
set groups PROTECT_RE_CONFIGLET policy-options prefix-list NTP_SERVERS_PEERS apply-path "system ntp peer <*>"
set groups PROTECT_RE_CONFIGLET policy-options prefix-list LOOPBACKS_V4 apply-path "interfaces lo0 unit 0 family inet address <*>"
set groups PROTECT_RE_CONFIGLET policy-options prefix-list LOCAL_IPV4 apply-path "interfaces <*> unit <*> family inet address <*>"
set groups PROTECT_RE_CONFIGLET firewall family inet filter cpp-filter term bgp from source-prefix-list BGP_NEIGHBORS_V4
set groups PROTECT_RE_CONFIGLET firewall family inet filter cpp-filter term bgp from source-prefix-list BGP_VRF_NEIGHBOURS_V4
set groups PROTECT_RE_CONFIGLET firewall family inet filter cpp-filter term bgp from protocol tcp
set groups PROTECT_RE_CONFIGLET firewall family inet filter cpp-filter term bgp from destination-port 179
set groups PROTECT_RE_CONFIGLET firewall family inet filter cpp-filter term bgp then count cpp_bgp_accept
set groups PROTECT_RE_CONFIGLET firewall family inet filter cpp-filter term bgp then accept
set groups PROTECT_RE_CONFIGLET firewall family inet filter cpp-filter term ssh from source-prefix-list REMOTE_MGMT_NETS_V4
set groups PROTECT_RE_CONFIGLET firewall family inet filter cpp-filter term ssh from protocol tcp
set groups PROTECT_RE_CONFIGLET firewall family inet filter cpp-filter term ssh from destination-port ssh
