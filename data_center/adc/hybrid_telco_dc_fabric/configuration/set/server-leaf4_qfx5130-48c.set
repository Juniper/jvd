set protocols router-advertisement interface et-0/0/54.0 max-advertisement-interval 30
set protocols router-advertisement interface et-0/0/54.0 min-advertisement-interval 10
set protocols router-advertisement interface et-0/0/55.0 max-advertisement-interval 30
set protocols router-advertisement interface et-0/0/55.0 min-advertisement-interval 10
set protocols bgp group l3clos-l type external
set protocols bgp group l3clos-l multipath multiple-as
set protocols bgp group l3clos-l bfd-liveness-detection minimum-interval 1000
set protocols bgp group l3clos-l bfd-liveness-detection multiplier 3
set protocols bgp group l3clos-l neighbor 2001:2001:2001:2001::6 description facing_spine1
set protocols bgp group l3clos-l neighbor 2001:2001:2001:2001::6 local-address 2001:2001:2001:2001::7
set protocols bgp group l3clos-l neighbor 2001:2001:2001:2001::6 family inet unicast extended-nexthop
set protocols bgp group l3clos-l neighbor 2001:2001:2001:2001::6 family inet6 unicast
set protocols bgp group l3clos-l neighbor 2001:2001:2001:2001::6 export ( LEAF_TO_SPINE_FABRIC_OUT && BGP-AOS-Policy )
set protocols bgp group l3clos-l neighbor 2001:2001:2001:2001::6 peer-as 100
set protocols bgp group l3clos-l neighbor 2001:2001:2001:2001::16 description facing_spine2
set protocols bgp group l3clos-l neighbor 2001:2001:2001:2001::16 local-address 2001:2001:2001:2001::17
set protocols bgp group l3clos-l neighbor 2001:2001:2001:2001::16 family inet unicast extended-nexthop
set protocols bgp group l3clos-l neighbor 2001:2001:2001:2001::16 family inet6 unicast
set protocols bgp group l3clos-l neighbor 2001:2001:2001:2001::16 export ( LEAF_TO_SPINE_FABRIC_OUT && BGP-AOS-Policy )
set protocols bgp group l3clos-l neighbor 2001:2001:2001:2001::16 peer-as 101
set protocols bgp group l3clos-l vpn-apply-export
set protocols bgp group l3clos-l-evpn type external
set protocols bgp group l3clos-l-evpn multihop ttl 1
set protocols bgp group l3clos-l-evpn multihop no-nexthop-change
set protocols bgp group l3clos-l-evpn family evpn signaling loops 2
set protocols bgp group l3clos-l-evpn multipath multiple-as
set protocols bgp group l3clos-l-evpn bfd-liveness-detection minimum-interval 3000
set protocols bgp group l3clos-l-evpn bfd-liveness-detection multiplier 3
set protocols bgp group l3clos-l-evpn neighbor fd86:8ff:73b0:22de:: description facing_spine1-evpn-overlay
set protocols bgp group l3clos-l-evpn neighbor fd86:8ff:73b0:22de:: local-address fd86:8ff:73b0:22de::5
set protocols bgp group l3clos-l-evpn neighbor fd86:8ff:73b0:22de:: family evpn signaling
set protocols bgp group l3clos-l-evpn neighbor fd86:8ff:73b0:22de:: export ( LEAF_TO_SPINE_EVPN_OUT && EVPN_EXPORT )
set protocols bgp group l3clos-l-evpn neighbor fd86:8ff:73b0:22de:: peer-as 100
set protocols bgp group l3clos-l-evpn neighbor fd86:8ff:73b0:22de::1 description facing_spine2-evpn-overlay
set protocols bgp group l3clos-l-evpn neighbor fd86:8ff:73b0:22de::1 local-address fd86:8ff:73b0:22de::5
set protocols bgp group l3clos-l-evpn neighbor fd86:8ff:73b0:22de::1 family evpn signaling
set protocols bgp group l3clos-l-evpn neighbor fd86:8ff:73b0:22de::1 export ( LEAF_TO_SPINE_EVPN_OUT && EVPN_EXPORT )
set protocols bgp group l3clos-l-evpn neighbor fd86:8ff:73b0:22de::1 peer-as 101
set protocols bgp group l3clos-l-evpn vpn-apply-export
set protocols bgp enable-oc-attr-set
set protocols bgp log-updown
set protocols bgp graceful-restart dont-help-shared-fate-bfd-down
set protocols bgp multipath
set protocols l2-learning telemetry enable-remote-entries
set protocols l2-learning crb-proxy-mac family inet 02:fc:00:00:00:02
set protocols l2-learning crb-proxy-mac family inet6 02:fc:00:00:00:02
set protocols lldp port-id-subtype interface-name
set protocols lldp port-description-type interface-description
set protocols lldp neighbour-port-info-display port-id
set protocols lldp interface all
set protocols rstp bridge-priority 0
set protocols rstp interface et-0/0/50 edge
set protocols rstp interface ae2 edge
set protocols rstp bpdu-block-on-edge
