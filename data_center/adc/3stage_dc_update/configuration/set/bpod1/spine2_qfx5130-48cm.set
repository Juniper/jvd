set version 25.2X100-D30.4-EVO
set groups PROTECT_RE_CONFIGLET interfaces lo0 unit 0 family inet filter input cpp-filter
set groups PROTECT_RE_CONFIGLET interfaces lo0 unit 0 family inet6 filter input cpp-filter-ipv6
set groups PROTECT_RE_CONFIGLET policy-options prefix-list BGP_NEIGHBORS_V4 apply-path "protocols bgp group <*> neighbor <*>"
set groups PROTECT_RE_CONFIGLET policy-options prefix-list BGP_VRF_NEIGHBOURS_V4 apply-path "routing-instances <*> protocols bgp group <*> neighbor <*>"
set groups PROTECT_RE_CONFIGLET policy-options prefix-list REMOTE_MGMT_NETS_V4 10.0.0.0/8
set groups PROTECT_RE_CONFIGLET policy-options prefix-list REMOTE_MGMT_NETS_V4 66.0.0.0/8
