set groups PROTECT_RE_CONFIGLET policy-options prefix-list DNS_SERVERS_V4 apply-path "system name-server <*>"
set groups PROTECT_RE_CONFIGLET policy-options prefix-list NTP_SERVERS_V4 apply-path "system ntp server <*>"
set groups PROTECT_RE_CONFIGLET policy-options prefix-list NTP_SERVERS_PEERS apply-path "system ntp peer <*>"
set groups PROTECT_RE_CONFIGLET policy-options prefix-list LOOPBACKS_V4 apply-path "interfaces lo0 unit 0 family inet address <*>"
set groups PROTECT_RE_CONFIGLET policy-options prefix-list LOCAL_IPV4 apply-path "interfaces <*> unit <*> family inet address <*>"
set groups PROTECT_RE_CONFIGLET firewall family inet filter cpp-filter term bgp from source-prefix-list BGP_NEIGHBORS_V4
