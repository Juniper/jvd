{
  "schemaVersion": 1,
  "jvd": "metro_ethernet_business_services",
  "description": "Canonical machine-readable composition matrix. One entry per form advertised in byoai/MENU.md. Supported devices are NOT duplicated here: they are resolved from each entry snippet's Seen-on rows, which remain the single source of device applicability. Validated by portal/scripts/composition-validate.mjs.",
  "statusVocabulary": {
    "supported": "Every entry snippet resolves and the form composes for at least one device.",
    "incomplete": "Advertised but not yet resolvable to a unique entry snippet set; reason required.",
    "intentionally-unsupported": "Advertised as out of scope for this JVD; reason required.",
    "deprecated": "Withdrawn; reason required."
  },
  "roles": {
    "an": "access node",
    "ma": "metro access",
    "meg": "metro edge gateway",
    "mse": "metro services edge",
    "mdr": "metro distribution router",
    "cr": "core router",
    "ag": "aggregation"
  },
  "identityVariables": {
    "description": "Correlated names: the reference and the definition bind the same value within one service, so they resolve by symbolic equality.",
    "constructs": ["policy-statement:$INSTANCE_NAME", "community:$INSTANCE_NAME_RT", "policy-statement:$POLICY_NAME", "policy-statement:$PPLB_NAME"]
  },
  "roleBindings": {
    "description": "Slots, not identities. A role parameter names a position to be filled by a selected construct, so it can never be resolved by symbolic equality. Keyed by construct (kind:name) because one spelling can be an identity in one kind and a role in another: policy-statement:$INSTANCE_NAME is correlated, community:$INSTANCE_NAME is not.",
    "bindings": [
      {
        "construct": "community:$INSTANCE_NAME",
        "families": ["l3vpn", "irb"],
        "provider": {
          "junos": "junos/policy-options/community/cm-l3vpn.conf",
          "evo": "evo/policy-options/community/cm-l3vpn.conf"
        },
        "rationale": "The reference spells the per-service L3VPN route-target community as $INSTANCE_NAME (for example METRO_L3VPN_2002); the definition spells the same construct METRO_L3VPN_$L3VPN_ID. One construct, two spellings — not a missing definition."
      },
      {
        "construct": "policy-statement:$EXPORT_POL",
        "families": ["e-line", "e-lan", "e-tree", "e-access"],
        "provider": {
          "junos": "junos/policy-options/policy-statement/ps-export-l2-color.conf",
          "evo": "evo/policy-options/policy-statement/ps-export-l2-color.conf"
        },
        "rationale": "Every device that runs only L2 services binds exactly this one policy body: an1_mx204, ma1-1_acx7024, ma1-2_acx7024 and ma5_mx204 each resolve to a single provider across every vrf-export on the device."
      },
      {
        "construct": "community:$COLOR_COMMUNITY",
        "families": ["e-line", "e-lan", "e-tree", "e-access"],
        "selection": "required",
        "providers": {
          "junos": ["junos/policy-options/community/cm-tc-map2gold.conf", "junos/policy-options/community/cm-tc-map2bronze.conf"],
          "evo": ["evo/policy-options/community/cm-tc-map2gold.conf", "evo/policy-options/community/cm-tc-map2bronze.conf"]
        },
        "rationale": "Service tier, and the operator must state it. Gold is the more common binding but it is not a default: bronze is validated on an3_acx7100-48l, ma1-1_acx7024, ma1-2_acx7024, meg1_acx7100-32c and meg2_acx7509, and the two steer onto different transport classes."
      },
      {
        "construct": "policy-statement:$IMPORT_POL",
        "families": ["l3vpn"],
        "provider": {
          "junos": "junos/policy-options/policy-statement/ps-import-l3vpn-internet.conf",
          "evo": "evo/policy-options/policy-statement/ps-import-l3vpn-internet.conf"
        },
        "rationale": "Every PE-CE VRF on every device this family reaches binds this one import policy: 200 on an3_acx7100-48l, 200 on ma3_acx7100-48l, 2999 on ma4_mx204, 3299 on mse1_mx304 and 3299 on mse2_mx304, with no other body observed."
      },
      {
        "construct": "policy-statement:$IMPORT_POL",
        "families": ["irb"],
        "provider": {
          "junos": "junos/policy-options/policy-statement/ps-import-l3vpn.conf",
          "evo": "evo/policy-options/policy-statement/ps-import-l3vpn.conf"
        },
        "rationale": "Every IP-prefix VRF binds this one import policy: 50 instances each on an3_acx7100-48l, mse1_mx304 and mse2_mx304, with no other body observed."
      },
      {
        "construct": "policy-statement:$EXPORT_POL",
        "families": ["irb"],
        "provider": {
          "junos": "junos/policy-options/policy-statement/ps-export-l3vpn-public.conf",
          "evo": "evo/policy-options/policy-statement/ps-export-l3vpn-public.conf"
        },
        "rationale": "Both devices this family reaches bind this one export policy for their IP-prefix VRFs: 50 instances on an3_acx7100-48l and 50 on mse1_mx304. mse2_mx304 uses the RT-5 NLRI form instead, but no supported form reaches it for this family."
      },
      {
        "construct": "policy-statement:$EXPORT_POL",
        "families": ["l3vpn"],
        "selection": "required",
        "providers": {
          "junos": [
            "junos/policy-options/policy-statement/ps-export-l3vpn-public-default-2.conf",
            "junos/policy-options/policy-statement/ps-export-l3vpn-public-default-3.conf",
            "junos/policy-options/policy-statement/ps-export-l3vpn-public-default-4.conf",
            "junos/policy-options/policy-statement/ps-export-l3vpn-public-default-3-color.conf",
            "junos/policy-options/policy-statement/ps-export-l3vpn-public-default-v6-2.conf",
            "junos/policy-options/policy-statement/ps-export-l3vpn-public-default-v6-3.conf",
            "junos/policy-options/policy-statement/ps-export-l3vpn-public-default-v6-4.conf"
          ],
          "evo": [
            "evo/policy-options/policy-statement/ps-export-l3vpn-public-default-2.conf",
            "evo/policy-options/policy-statement/ps-export-l3vpn-public-default-3.conf",
            "evo/policy-options/policy-statement/ps-export-l3vpn-public-default-4.conf",
            "evo/policy-options/policy-statement/ps-export-l3vpn-public-default-v6-2.conf",
            "evo/policy-options/policy-statement/ps-export-l3vpn-public-default-v6-4.conf"
          ]
        },
        "rationale": "The export policy carries the customer prefixes, so the choice is a service parameter the operator must state: address family, how many CE prefixes the VRF advertises, and whether the routes are coloured. All forms are validated in the JVD and none is a default — ma4_mx204 alone splits 999 coloured v4 against 1000 v6."
      }
    ]
  },
